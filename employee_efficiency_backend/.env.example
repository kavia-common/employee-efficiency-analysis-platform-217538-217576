# Backend environment configuration for Employee Efficiency Analysis Platform

# PostgreSQL connection URL (SQLAlchemy format)
# Example uses local Postgres on port 5001 with default postgres/postgres credentials and database "employee_efficiency"
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5001/employee_efficiency

# Optional: data storage directory for uploaded CSV files and generated artifacts
DATA_DIR=employee-efficiency-analysis-platform-217538-217576/employee_efficiency_backend/data

# Optional: reports templates directory (kept for reference)
REPORT_TEMPLATES_DIR=employee-efficiency-analysis-platform-217538-217576/employee_efficiency_backend/reports/templates
